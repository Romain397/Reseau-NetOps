! Généré par scripts/prepare.py depuis data/fabric.yml (phase de base).
hostname {{ name }}
!
vrf instance MGMT
!
interface Management0
   vrf MGMT
   ip address {{ management }}/{{ management_prefix }}
   no shutdown
!
ip route vrf MGMT 0.0.0.0/0 {{ management_gateway }}
!
ip routing
!
interface Loopback0
   ip address {{ loopback }}/32
!
{% for interface in interfaces %}
interface {{ interface.name }}
   description {{ interface.peer }}
   no switchport
   ip address {{ interface.address }}
   no shutdown
!
{% endfor %}
end
